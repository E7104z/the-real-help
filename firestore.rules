rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    function hasRole(tenantId, role) {
      return isTenantMember(tenantId) && request.auth.token.role == role;
    }

    function isAdmin(tenantId) {
      return hasRole(tenantId, 'admin');
    }

    function isStaff(tenantId) {
      return hasRole(tenantId, 'staff') || isAdmin(tenantId);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Admins collection (Firestore-based admin auth) ──

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // managed via Admin SDK only
    }

    // ── Pending Clients (from contact form) ──

    match /pendingClients/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only
    }

    // ── Clients collection (portal) ──

    match /clients/{clientId} {
      allow read, write: if isSignedIn() && request.auth.uid == clientId;

      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == clientId;
        allow write: if false; // managed via Admin SDK / Cloud Functions
      }

      match /documents/{documentId} {
        allow read: if isSignedIn() && request.auth.uid == clientId;
        allow create: if isSignedIn() && request.auth.uid == clientId;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid == clientId;
        allow create: if isSignedIn() && request.auth.uid == clientId;
        allow update: if isSignedIn() && request.auth.uid == clientId;
        allow delete: if false;
      }
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if isAdmin(tenantId);

      // Users within a tenant
      match /users/{userId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isAdmin(tenantId);
        allow update: if isOwner(userId) || isAdmin(tenantId);
        allow delete: if isAdmin(tenantId);
      }

      // Records
      match /records/{recordId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isStaff(tenantId);
        allow update: if isStaff(tenantId);
        allow delete: if isAdmin(tenantId);
      }

      // Workflows
      match /workflows/{workflowId} {
        allow read: if isTenantMember(tenantId);
        // Writes handled via Cloud Functions
        allow write: if false;
      }

      // Files metadata
      match /files/{fileId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId);
        allow update: if isStaff(tenantId);
        allow delete: if isAdmin(tenantId);
      }

      // Audit logs — read-only from client, written by functions
      match /auditLogs/{logId} {
        allow read: if isAdmin(tenantId);
        allow write: if false;
      }
    }
  }
}
